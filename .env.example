# Copia este archivo a .env y llena los valores. .env NUNCA se sube al repo.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# Opcional: sin key, el dictado usa el intérprete local del catálogo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true = cada cobro es real por $0.01 sin importar el total, y la pantalla lo dice
MODO_DEMO=true
# PIN de demostración de la consola del dueño (v1; no es autenticación de producción)
OWNER_PIN=1234
# Ruta opcional de la base SQLite del backend v1; por defecto server/data/abarpay.db
ABARPAY_DB=
